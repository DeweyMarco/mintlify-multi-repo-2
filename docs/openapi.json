{
  "openapi": "3.1.0",
  "info": {
    "title": "Shortest Path API",
    "description": "Find a minimum-cost route through a non-negatively weighted graph.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/shortest-path": {
      "post": {
        "tags": [
          "Paths"
        ],
        "summary": "Find Shortest Path",
        "operationId": "find_shortest_path_shortest_path_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PathRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PathResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Edge": {
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "title": "Target"
          },
          "weight": {
            "type": "number",
            "minimum": 0.0,
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target",
          "weight"
        ],
        "title": "Edge"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PathRequest": {
        "properties": {
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "maxItems": 20000,
            "title": "Edges"
          },
          "start": {
            "type": "string",
            "minLength": 1,
            "title": "Start"
          },
          "end": {
            "type": "string",
            "minLength": 1,
            "title": "End"
          },
          "directed": {
            "type": "boolean",
            "title": "Directed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "edges",
          "start",
          "end"
        ],
        "title": "PathRequest"
      },
      "PathResponse": {
        "properties": {
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "reachable",
          "distance",
          "path"
        ],
        "title": "PathResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
